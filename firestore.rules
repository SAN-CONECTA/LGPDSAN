rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function uPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function active() { return request.auth != null && exists(uPath()) && get(uPath()).data.ativo == true; }
    function role() { return get(uPath()).data.role; }
    function isAdmin() { return active() && role() == 'admin'; }
    function myContabs() { return get(uPath()).data.get('contabilidades', []); }
    // Acesso a uma contabilidade: Administrador (todas) ou usuário vinculado a ela.
    function hasContab(cid) { return isAdmin() || (active() && cid in myContabs()); }

    // Perfis. Cada usuário lê o próprio; só o administrador lista. Alterações pelas Functions (exceto o tema).
    match /users/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      // Criação, edição, bloqueio e remoção de perfis: só pelas Functions (adminSaveUser etc.), que auditam.
      allow create, delete: if false;
      // Cada usuário pode alterar apenas a própria preferência de tema (auto, claro, escuro e temas de cor).
      allow update: if request.auth != null && request.auth.uid == uid && active()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tema'])
        && request.resource.data.tema in ['auto', 'claro', 'escuro', 'azul', 'lilas', 'rosa', 'laranja', 'verde', 'grafite', 'escuro-azul', 'escuro-lilas'];

      // Status de leitura das atualizações ANPD: cada usuário lê e marca apenas as suas.
      match /anpdLidas/{pubId} {
        allow read, create, delete: if active() && request.auth.uid == uid;
        allow update: if false;
      }
    }

    // Publicações oficiais da ANPD, sincronizadas do gov.br pelo GitHub Actions
    // (scripts/anpd_sync.py) usando a Admin SDK, que ignora as regras. Todos os
    // usuários ativos leem; ninguém consegue gravar pelo app — o conteúdo oficial é imutável.
    match /anpd/{pubId} {
      allow read: if active();
      allow write: if false;
    }

    // Categorias: alteradas só pela Function adminCategorias (com auditoria).
    match /config/{doc} {
      allow read: if active();
      allow write: if false;
      match /versoes/{n} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // Auditoria do SISTEMA (login, usuários, contabilidades, categorias): só o administrador lê.
    // Gravada exclusivamente pelas Cloud Functions (Admin SDK), com lista fechada de ações. Ninguém grava, edita ou apaga pelo app.
    match /auditoria/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Tudo de uma contabilidade fica sob contabilidades/{cid}; o isolamento vem do caminho.
    match /contabilidades/{cid} {
      allow get: if hasContab(cid);
      allow list: if isAdmin();
      // Criação, edição, exclusão lógica e restauração: só pelas Functions (adminSaveContabilidade etc.).
      allow create, update: if false;
      allow delete: if false;

      // Nomes das pessoas da contabilidade (campo Responsável). Mantido pelo administrador.
      match /pessoas/{uid} {
        allow read: if hasContab(cid);
        allow write: if false; // mantido pelas Functions de usuários
      }

      // Registros e versões: o navegador só lê. Criar, editar, restaurar versão, aprovar e excluir passam
      // pelas Functions (saveRecord, restoreRecordVersion, approveRecord, softDeleteRecord, hardDeleteRecord),
      // que gravam registro + próxima versão + auditoria na mesma transação.
      match /registros/{id} {
        allow read: if hasContab(cid) && (resource.data.deleted == false || isAdmin());
        allow write: if false;

        // Versões são imutáveis e só o servidor as cria.
        match /versoes/{n} {
          allow read: if hasContab(cid)
            && (get(/databases/$(database)/documents/contabilidades/$(cid)/registros/$(id)).data.deleted == false || isAdmin());
          allow write: if false;
        }
      }

      // Evidências (metadados listados na tela). Criadas na finalização do upload e apagadas pela Function deleteEvidence.
      match /evidencias/{id} {
        allow read: if hasContab(cid);
        allow write: if false;
      }

      // Reservas/arquivos de evidência (pending → ready). Só o servidor lê e grava; o storage.rules consulta este
      // documento para aceitar o upload (reserva pendente do próprio usuário) e para servir o arquivo (pronto).
      match /evidenciasArquivos/{id} {
        allow read, write: if false;
      }

      // Auditoria da contabilidade: quem tem acesso lê; só as Functions gravam; ninguém edita ou apaga.
      match /auditoria/{id} {
        allow read: if hasContab(cid);
        allow write: if false;
      }

      match /configDiagnostico/{doc} {
        allow read: if hasContab(cid);
        allow write: if false;
        match /versoes/{n} {
          allow read: if hasContab(cid);
          allow write: if false;
        }
      }

      match /planosAcao/{recordId} {
        allow read: if hasContab(cid);
        allow write: if false;
        match /versoes/{n} {
          allow read: if hasContab(cid);
          allow write: if false;
        }
      }
    }
  }
}
