rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function uPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function active() { return request.auth != null && exists(uPath()) && get(uPath()).data.ativo == true; }
    function role() { return get(uPath()).data.role; }
    function isAdmin() { return active() && role() == 'admin'; }
    function myContabs() { return get(uPath()).data.get('contabilidades', []); }
    // Acesso a uma contabilidade: Administrador (todas) ou usuário vinculado a ela.
    function hasContab(cid) { return isAdmin() || (active() && cid in myContabs()); }
    // Escrita em uma contabilidade: Administrador ou usuário de Edição vinculado.
    function canEditIn(cid) { return isAdmin() || (active() && role() == 'edicao' && cid in myContabs()); }

    // Aprovação formal: só o administrador altera, e só para a versão que está gravando, com o próprio nome e a hora do servidor.
    function aprovOk() {
      return request.resource.data.get('aprovacao', null) == resource.data.get('aprovacao', null)
        || (isAdmin() && request.resource.data.aprovacao.porId == request.auth.uid
            && request.resource.data.aprovacao.versao == request.resource.data.versao
            && request.resource.data.aprovacao.em == request.time);
    }

    function validSnap(s) {
      return s.titulo is string && s.titulo.size() > 0 && s.titulo.size() <= 200
        && s.descricao is string && s.descricao.size() <= 20000
        && s.evidencias is string && s.evidencias.size() <= 5000
        && s.status in ['Rascunho', 'Em vigor', 'Em revisão', 'Arquivado']
        && s.prioridade in ['Baixa', 'Média', 'Alta']
        && s.categoria is string && s.responsavel is string && s.prazo is string
        && s.get('revisao', '') is string && s.get('revisao', '').size() <= 10
        && s.get('dados', {}) is map && s.get('dados', {}).size() <= 250;
    }

    // Perfis. Cada usuário lê o próprio; só o administrador lista e altera.
    match /users/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
      // Cada usuário pode alterar apenas a própria preferência de tema (claro / escuro / auto).
      allow update: if request.auth != null && request.auth.uid == uid && active()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tema'])
        && request.resource.data.tema in ['auto', 'claro', 'escuro'];
    }

    match /config/{doc} {
      allow read: if active();
      allow write: if isAdmin() && request.resource.data.lista is list;
    }

    // Auditoria do SISTEMA (login, usuários, contabilidades, categorias): só o administrador lê; ninguém edita ou apaga.
    match /auditoria/{id} {
      allow read: if isAdmin();
      allow create: if active()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.ts == request.time
        && request.resource.data.user == get(uPath()).data.nome
        && request.resource.data.role == role()
        && request.resource.data.escopo == 'sistema'
        && request.resource.data.acao is string;
      allow update, delete: if false;
    }

    // Tudo de uma contabilidade fica sob contabilidades/{cid}; o isolamento vem do caminho.
    match /contabilidades/{cid} {
      allow get: if hasContab(cid);
      allow list: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 100
        && (!('logo' in request.resource.data) || (request.resource.data.logo is string && request.resource.data.logo.size() <= 300000));
      allow delete: if false;

      // Nomes das pessoas da contabilidade (campo Responsável). Mantido pelo administrador.
      match /pessoas/{uid} {
        allow read: if hasContab(cid);
        allow write: if isAdmin();
      }

      match /registros/{id} {
        allow read: if hasContab(cid) && (resource.data.deleted == false || isAdmin());
        allow create: if canEditIn(cid)
          && validSnap(request.resource.data.snap)
          && request.resource.data.versao == 1
          && request.resource.data.deleted == false
          && !('aprovacao' in request.resource.data)
          && (isAdmin() || request.resource.data.snap.status != 'Arquivado');
        allow update: if (isAdmin() && validSnap(request.resource.data.snap) && aprovOk())
          || (canEditIn(cid) && role() == 'edicao'
              && resource.data.deleted == false && request.resource.data.deleted == false
              && resource.data.snap.status != 'Arquivado' && request.resource.data.snap.status != 'Arquivado'
              && validSnap(request.resource.data.snap)
              && request.resource.data.get('aprovacao', null) == resource.data.get('aprovacao', null)
              && request.resource.data.versao == resource.data.versao + 1);
        allow delete: if isAdmin();

        // Versões são imutáveis; só o administrador apaga (exclusão permanente do registro).
        match /versoes/{n} {
          allow read: if hasContab(cid)
            && (get(/databases/$(database)/documents/contabilidades/$(cid)/registros/$(id)).data.deleted == false || isAdmin());
          allow create: if canEditIn(cid) && request.resource.data.autorId == request.auth.uid
            && validSnap(request.resource.data.snap);
          allow update: if false;
          allow delete: if isAdmin();
        }
      }

      // Evidências (metadados; o arquivo fica no Firebase Storage, ver storage.rules).
      // Edição/admin enviam; ninguém altera; só o administrador exclui.
      match /evidencias/{id} {
        allow read: if hasContab(cid);
        allow create: if canEditIn(cid)
          && request.resource.data.autorId == request.auth.uid
          && request.resource.data.contabId == cid
          && request.resource.data.ts == request.time
          && request.resource.data.categoria is string && request.resource.data.categoria.size() <= 100
          && request.resource.data.descricao is string && request.resource.data.descricao.size() > 0 && request.resource.data.descricao.size() <= 300
          && request.resource.data.nome is string && request.resource.data.nome.size() <= 200
          && request.resource.data.tamanho is int && request.resource.data.tamanho > 0 && request.resource.data.tamanho <= 10485760
          && (!('registroId' in request.resource.data) || (request.resource.data.registroId is string && request.resource.data.registroId.size() <= 100
              && request.resource.data.itemId is string && request.resource.data.itemId.size() <= 100
              && request.resource.data.itemRot is string && request.resource.data.itemRot.size() <= 200))
          && request.resource.data.path is string && request.resource.data.path.matches('evidencias/' + cid + '/.*');
        allow update: if false;
        allow delete: if isAdmin();
      }

      // Auditoria da contabilidade: quem tem acesso lê; edição/admin criam; ninguém edita ou apaga.
      match /auditoria/{id} {
        allow read: if hasContab(cid);
        allow create: if canEditIn(cid)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.ts == request.time
          && request.resource.data.user == get(uPath()).data.nome
          && request.resource.data.role == role()
          && request.resource.data.escopo == 'registro'
          && request.resource.data.contabId == cid
          && request.resource.data.acao is string;
        allow update, delete: if false;
      }
    }
  }
}
