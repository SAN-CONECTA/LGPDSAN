# Credenciais nunca entram no repositório.
# O serviço de conta do Firebase chega por secret do GitHub Actions.
service-account*.json
*service-account*.json
*.credentials.json
.env
.env.*
# Exceção: nome do bucket das Functions por projeto (configuração pública, não é segredo).
!functions/.env.lgpdsan

# Artefatos de Python
__pycache__/
*.pyc

# Logs do Firebase Emulator Suite (testes locais)
firebase-debug.log
firestore-debug.log
ui-debug.log
database-debug.log
pubsub-debug.log
storage-debug.log
firebase-export-*/

# Dependências (Functions e ferramentas de teste)
node_modules/
test-results/
playwright-report/
